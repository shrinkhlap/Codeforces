#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr)
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;
        vector<long long> a(n);
        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }

        long long pref = 0;
        long long mn = LLONG_MAX;

        for (int i = 0; i < n; i++) {
            pref += a[i];

            long long cur = pref / (i + 1);
            mn = min(mn, cur);

            cout << mn << " ";
        }
        cout << '\n';
    }

    return 0;
}
