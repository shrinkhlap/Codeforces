#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<long long> a(n);
        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }

        sort(a.begin(), a.end());

        int ans = n;

        int i = 0;
        while (i < n) {
            int j = i;

            while (j < n && a[j] == a[i]) {
                j++;
            }

            int L = i;       
            int R = n - j;   

            ans = min(ans, max(L, R));

            i = j;
        }

        cout << ans << '\n';
    }

    return 0;
}
