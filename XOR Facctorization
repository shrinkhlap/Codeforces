#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;

    while (T--) {
        long long n;
        int k;
        cin >> n >> k;

        vector<long long> ans;

        if (k % 2 == 1) {
            // All n's
            ans.assign(k, n);
        } else {
            long long a, b;

            // n is a power of two OR n = 2^m - 1
            if ((n & (n - 1)) == 0 || (n & (n + 1)) == 0) {
                a = 0;
                b = n;
            } else {
                int h = 63 - __builtin_clzll(n); // highest set bit

                int r = -1;
                for (int i = h - 1; i >= 0; --i) {
                    if ((n >> i) & 1) {
                        r = i;
                        break;
                    }
                }

                long long t = 0;
                for (int i = 0; i < r; ++i) {
                    if (((n >> i) & 1) == 0) {
                        t |= (1LL << i);
                    }
                }

                a = t | (1LL << r);
                b = n ^ a;
            }

            for (int i = 0; i < k - 2; ++i) ans.push_back(n);
            ans.push_back(a);
            ans.push_back(b);
        }

        for (int i = 0; i < k; ++i) {
            if (i) cout << ' ';
            cout << ans[i];
        }
        cout << '\n';
    }

    return 0;
}
