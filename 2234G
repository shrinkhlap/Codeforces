#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector<long long> a(n);
        for (int i = 0; i < n; i++) cin >> a[i];

        int winner = (n % 2 ? 1 : 2); 
        for (int i = 0; i < n; i++) {
            if (a[i] >= n + 1 - (i + 1)) {
                
                winner = ((i + 1) % 2 ? 1 : 2);
                break;
            }
        }
        cout << winner << "\n";
    }
    return 0;
}
